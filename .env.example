APP_NAME=KnowForge
APP_ENV=local
APP_DEBUG=false

DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=knowforge
DB_USER=knowforge
DB_PASSWORD=knowforge

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=1440

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=40
GROQ_MAX_COMPLETION_TOKENS=2048
GROQ_COMPILE_MAX_COMPLETION_TOKENS=6000
GROQ_COMPILE_TIMEOUT_SECONDS=120

LLM_KEY_ENCRYPTION_SECRET=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@knowforge.local
SMTP_USE_TLS=true
VERIFICATION_CODE_MINUTES=15

KNOWFORGE_STORAGE_PATH=storage
MAX_PDF_UPLOAD_BYTES=104857600
PDF_EXTRACT_CHAR_LIMIT=1200000

WIKI_CONTEXT_CHAR_BUDGET=40000
CHAT_CONTEXT_CHAR_BUDGET=18000
CHAT_PROMPT_TOKEN_BUDGET=5500
CHAT_MAX_COMPLETION_TOKENS=900
CHAT_HISTORY_CHAR_BUDGET=6000
CHAT_HISTORY_KEEP_LAST=6
WIKI_PAGE_SOFT_CHAR_LIMIT=120000
WIKI_COMPILE_CHUNK_CHARS=24000
WIKI_COMPILE_MAX_CHUNKS=24

KG_MAX_ENTITIES_PER_PAGE=40
KG_MAX_RELATED_PER_PAGE=12
KG_MAX_HOPS=1
KG_MAX_HOPS_HARD=2
KG_MAX_PAGES_IN_CONTEXT=6
KG_PLANNER_SUBQUESTIONS=3

CONTRADICTION_MAX_PAIRS_PER_SCAN=24
CONTRADICTION_EXCERPT_CHARS=4500
CONTRADICTION_SCAN_AFTER_INGEST=true
CONTRADICTION_INGEST_MAX_PAIRS=8

ENABLE_SEMANTIC_VECTOR_SEARCH=false
PINECONE_API_KEY=
PINECONE_INDEX_NAME=knowforge
HYBRID_VECTOR_WEIGHT=0.5

TAVILY_API_KEY=
TAVILY_SEARCH_URL=https://api.tavily.com/search
TAVILY_EXTRACT_URL=https://api.tavily.com/extract
TAVILY_SEARCH_DEPTH=advanced
WEB_SEARCH_TIMEOUT_SECONDS=20
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_CONTEXT_CHARS=7000

TIER4_DIGEST_ENABLED=true
TIER4_DIGEST_HOUR_UTC=3
TIER4_DIGEST_EMAIL_ENABLED=true
TIER4_FACT_EXPIRING_DAYS=30
